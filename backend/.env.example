# Trusted Backend Environment Variables (Render / Cloud Run / VPS)
# NEVER put these secrets in the Android app or commit a real .env file.
PORT=8080
APP_ENVIRONMENT=LIVE
FIRESTORE_DATABASE_ID=ai-studio-android-msageerp-1cabd974-084b-4311-b76c-3034d7a0e5a6

# On Render, RENDER_EXTERNAL_URL is auto-provided, or set your public HTTPS URL explicitly:
BACKEND_CALLBACK_BASE_URL=https://msageer-pay-backend.onrender.com

# Required on Render / non-GCP hosts: paste Firebase Service Account JSON (raw or base64)
# Download from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
FIREBASE_SERVICE_ACCOUNT_JSON=

# ClubKonnect (Nellobyte Systems) API Credentials — https://www.clubkonnect.com/apidocs.asp
CLUBKONNECT_USER_ID=
CLUBKONNECT_API_KEY=

# Flutterwave v3 API Credentials — https://developer.flutterwave.com/
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
FLUTTERWAVE_REDIRECT_URL=https://msageer-pay-backend.onrender.com/payment-complete
